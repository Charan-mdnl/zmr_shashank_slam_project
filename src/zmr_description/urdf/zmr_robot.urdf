   <geometry>
    <mesh filename="package://zmr_description/meshes/lidar-v1.stl" scale="0.001 0.001 0.001" />
   </geometry>
  </visual>
  <!-- Collision block removed for lidar_link so ray sensor doesn't collide with its own housing -->
