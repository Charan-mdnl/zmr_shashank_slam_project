<?xml version='1.0' encoding='utf-8'?>
<robot name="zmr_robot">
 <!-- Canonical CAD-matched ROS model. Visual/joint transforms preserved from the accepted model. -->
 <!-- ROS convention: X forward, Y left, Z up. -->
 <link name="base_footprint" />
 <link name="base_link" />
 <joint name="base_footprint_to_base_link" type="fixed">
  <parent link="base_footprint" />
  <child link="base_link" />
  <origin xyz="0 0 0" rpy="0 0 0" />
 </joint>
 <joint name="base_to_cad_base" type="fixed">
  <parent link="base_link" />
  <child link="cad_base_link" />
  <origin xyz="-0.525 0.355 0" rpy="0 0 -1.5707963267948966" />
 </joint>
 <link name="cad_base_link">
  <inertial>
   <origin xyz="0.355 0.525 0.105" rpy="0 0 0" />
   <mass value="10" />
   <inertia ixx="0.9555" ixy="0" ixz="0" iyy="0.456833" iyz="0" izz="1.338833" />
  </inertial>
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0" />
   <geometry>
    <mesh filename="package://zmr_description/meshes/zmr_body-v2.stl" scale="0.001 0.001 0.001" />
   </geometry>
  </visual>
  <collision>
   <origin xyz="0.355 0.525 0.105" rpy="0 0 0" />
   <geometry>
    <box size="0.71 1.05 0.21" />
   </geometry>
  </collision>
 </link>
 <link name="lidar_link">
