  <!-- Collision meshes intentionally mirror the accepted visual transforms. -->
  <!-- Passive caster contact/friction must be tuned in the target simulator. -->

 <!-- ============================================================== -->
 <!-- GAZEBO SIMULATION PLUGINS                                       -->
 <!-- These tags only affect Gazebo. RViz and real-robot use ignore    -->
 <!-- them. They add: colors, physics behavior, sensors, controllers. -->
 <!-- ============================================================== -->

 <!-- ── MATERIAL COLORS ──────────────────────────────────────────── -->
 <!-- WHY: Without these, every link appears default gray in Gazebo.  -->
 <!--      <gazebo reference="link_name"> sets Gazebo-specific        -->
 <!--      properties for that link. "material" sets the color.       -->
 <gazebo reference="cad_base_link">
  <material>Gazebo/DarkGrey</material>
 </gazebo>
 <gazebo reference="lidar_link">
  <material>Gazebo/Black</material>
 </gazebo>
 <gazebo reference="left_wheel">
  <material>Gazebo/Black</material>
 </gazebo>
 <gazebo reference="right_wheel">
  <material>Gazebo/Black</material>
 </gazebo>

 <!-- ── CASTER FRICTION ──────────────────────────────────────────── -->
 <!-- WHY: Caster wheels must slide freely — they're PASSIVE.         -->
 <!--      High friction would fight the drive wheels and stop the    -->
 <!--      robot from turning. mu1/mu2 = friction coefficients.      -->
 <!--      Setting them very low makes casters act like smooth balls. -->
 <gazebo reference="caster_fl_wheel">
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
  <material>Gazebo/Grey</material>
 </gazebo>
 <gazebo reference="caster_fr_wheel">
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
  <material>Gazebo/Grey</material>
 </gazebo>
 <gazebo reference="caster_rl_wheel">
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
  <material>Gazebo/Grey</material>
 </gazebo>
 <gazebo reference="caster_rr_wheel">
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
  <material>Gazebo/Grey</material>
 </gazebo>
 <gazebo reference="caster_fl_swivel">
  <material>Gazebo/Grey</material>
 </gazebo>
 <gazebo reference="caster_fr_swivel">
  <material>Gazebo/Grey</material>
 </gazebo>
 <gazebo reference="caster_rl_swivel">
  <material>Gazebo/Grey</material>
 </gazebo>
 <gazebo reference="caster_rr_swivel">
  <material>Gazebo/Grey</material>
 </gazebo>

 <!-- ── DIFFERENTIAL DRIVE PLUGIN ────────────────────────────────── -->
 <!-- WHY: This is the "brain" that makes your robot move in Gazebo.  -->
 <!--      It listens to /cmd_vel (velocity commands from keyboard    -->
 <!--      or navigation), applies torque to the left/right wheels,  -->
 <!--      and publishes /odom (where the robot thinks it is).       -->
 <!--                                                                 -->
 <!-- HOW IT WORKS:                                                   -->
 <!--   1. You publish: "go forward at 0.5 m/s" on /cmd_vel          -->
 <!--   2. Plugin calculates: both wheels need to spin at             -->
 <!--      0.5 / 0.08 = 6.25 rad/s (speed / wheel_radius)           -->
 <!--   3. Plugin applies torque to both wheel joints                 -->
 <!--   4. Plugin tracks how much wheels actually turned              -->
 <!--   5. Plugin publishes odom: "I've moved 0.5m forward"          -->
 <gazebo>
  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
   <!-- Which joints are the drive wheels? Must match joint names in URDF -->
   <left_joint>base_to_left_wheel</left_joint>
   <right_joint>base_to_right_wheel</right_joint>

   <!-- Physical dimensions from your robot_geometry.yaml -->
   <wheel_separation>0.526</wheel_separation>
   <wheel_diameter>0.160</wheel_diameter>

   <!-- Torque limit — how hard can the motors push (Nm) -->
   <max_wheel_torque>20.0</max_wheel_torque>
   <!-- Max speed the wheels can spin (rad/s). 6.25 ≈ 0.5 m/s -->
   <max_wheel_acceleration>1.0</max_wheel_acceleration>

   <!-- TOPIC NAMES — these are the ROS topics the plugin creates -->
   <!-- /cmd_vel: input — tells robot how fast to go -->
   <command_topic>cmd_vel</command_topic>
   <!-- /odom: output — tells ROS where robot has moved -->
   <odometry_topic>odom</odometry_topic>

   <!-- TF FRAMES — coordinate frame names -->
   <odometry_frame>odom</odometry_frame>
   <robot_base_frame>base_footprint</robot_base_frame>

   <!-- Publish the odom→base_footprint transform? YES! -->
   <!-- This is critical for SLAM — it tells SLAM Toolbox how far -->
   <!-- the robot has moved between scans. -->
   <publish_odom>true</publish_odom>
   <publish_odom_tf>true</publish_odom_tf>
   <publish_wheel_tf>true</publish_wheel_tf>

   <!-- How often to publish odometry (20 Hz) -->
   <update_rate>20.0</update_rate>
  </plugin>
 </gazebo>

 <!-- ── LIDAR SENSOR PLUGIN ──────────────────────────────────────── -->
 <!-- WHY: This simulates your RPLidar A3M1. Gazebo shoots invisible -->
 <!--      "laser rays" from lidar_link, measures distance to walls, -->
 <!--      and publishes a /scan topic — exactly like the real LiDAR. -->
 <!--                                                                 -->
 <!-- KEY PARAMETERS (matched to real A3M1):                          -->
 <!--   samples: 720 = one ray every 0.5° (360°/720)                 -->
 <!--   min_angle/max_angle: full 360° sweep                          -->
 <!--   range: 0.15m to 25m (A3M1 spec)                               -->
 <!--   update_rate: 10 Hz (A3M1 in Sensitivity mode)                 -->
 <gazebo reference="lidar_link">
  <sensor type="ray" name="rplidar_a3m1">
   <pose>0 0 0.05 0 0 0</pose>
   <visualize>true</visualize>
   <update_rate>10</update_rate>
   <ray>
    <scan>
     <horizontal>
      <samples>720</samples>
      <resolution>1</resolution>
      <min_angle>-3.14159265359</min_angle>
      <max_angle>3.14159265359</max_angle>
     </horizontal>
    </scan>
    <range>
     <min>0.20</min>
     <max>25.0</max>
     <resolution>0.01</resolution>
    </range>
    <noise>
     <!-- Gaussian noise simulates real-world sensor imperfection -->
     <type>gaussian</type>
     <mean>0.0</mean>
     <stddev>0.01</stddev>
    </noise>
   </ray>
   <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
    <ros>
     <!-- Topic name — same as real robot uses -->
     <remapping>~/out:=scan</remapping>
    </ros>
    <output_type>sensor_msgs/LaserScan</output_type>
    <frame_name>lidar_link</frame_name>
   </plugin>
  </sensor>
 </gazebo>

 <!-- ── JOINT STATE PUBLISHER PLUGIN ─────────────────────────────── -->
 <!-- WHY: ROS needs to know the position of every joint (how much   -->
 <!--      each wheel has rotated). This plugin reads Gazebo's       -->
 <!--      internal joint angles and publishes them to /joint_states. -->
 <!--      robot_state_publisher then uses this + URDF to compute    -->
 <!--      the full TF tree (where every part of the robot is).      -->
 <gazebo>
  <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
   <ros>
    <remapping>~/out:=joint_states</remapping>
   </ros>
   <update_rate>20</update_rate>
   <joint_name>base_to_left_wheel</joint_name>
   <joint_name>base_to_right_wheel</joint_name>
   <joint_name>base_to_caster_fl_swivel</joint_name>
   <joint_name>caster_fl_swivel_to_wheel</joint_name>
   <joint_name>base_to_caster_fr_swivel</joint_name>
   <joint_name>caster_fr_swivel_to_wheel</joint_name>
   <joint_name>base_to_caster_rl_swivel</joint_name>
   <joint_name>caster_rl_swivel_to_wheel</joint_name>
   <joint_name>base_to_caster_rr_swivel</joint_name>
   <joint_name>caster_rr_swivel_to_wheel</joint_name>
  </plugin>
 </gazebo>

</robot>