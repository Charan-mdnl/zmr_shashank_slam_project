   <origin xyz="0 0 0.025" rpy="0 0 0" />
   <mass value="1.7340118826" />
   <inertia ixx="0.000970866" ixy="0" ixz="0" iyy="0.000970866" iyz="0" izz="0.001219227" />
  </inertial>
  <visual>
