<?xml version="1.0" ?>
<!--
  ZMR Test World — A simple office/room layout for SLAM testing.
  
  WHAT IS A .world FILE?
  It's an SDF (Simulation Description Format) file that tells Gazebo
  what the environment looks like: ground plane, walls, lighting, etc.
  Think of it as the "map" your robot will explore.
  
  This world has:
  - A ground plane (the floor)
  - Sun light (so you can see things)
  - Several walls forming rooms and corridors
  - The layout is roughly 10m x 8m — a small office
-->
<sdf version="1.9">
 <world name="zmr_test_world">

  <!-- ── PHYSICS ENGINE ─────────────────────────────────────────── -->
  <!-- Controls simulation speed and accuracy -->
  <physics name="1ms" type="ignored">
   <max_step_size>0.001</max_step_size>
   <real_time_factor>1.0</real_time_factor>
  </physics>

  <!-- Gazebo Sim requires its systems to be declared explicitly. Without
       these the world loads but nothing steps, no sensor renders and no
       model command is accepted. -->
  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system"
          name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
   <render_engine>ogre2</render_engine>
  </plugin>

  <!-- ── LIGHTING ───────────────────────────────────────────────── -->
  <light type="directional" name="sun">
   <cast_shadows>true</cast_shadows>
   <pose>0 0 10 0 0 0</pose>
   <diffuse>0.8 0.8 0.8 1</diffuse>
   <specular>0.2 0.2 0.2 1</specular>
   <direction>-0.5 0.1 -0.9</direction>
  </light>

  <!-- ── GROUND PLANE ───────────────────────────────────────────── -->
  <model name="ground_plane">
   <static>true</static>
   <link name="link">
    <collision name="collision">
     <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
    </collision>
    <visual name="visual">
     <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
     <material>
      <ambient>0.8 0.8 0.8 1</ambient>
      <diffuse>0.8 0.8 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- ── WALLS ──────────────────────────────────────────────────── -->
  <!--
    Each wall is a simple box model.
    Layout (top view, numbers in meters):
    
         0     2     4     6     8    10
    8  ┌─────────────────────────────────┐
       │                                 │
    6  │     ┌────────┐                  │
       │     │  Room1  │     Room2       │
    4  │     └────┐   │   ┌─────────────│
       │          │   │   │             │
    2  │  Hallway │   │   │   Room3     │
       │          │   └───┘             │
    0  └─────────────────────────────────┘
  -->

  <!-- Outer wall — North (top) -->
  <model name="wall_north">
   <static>true</static>
   <pose>5 8 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>10 0.15 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>10 0.15 1.0</size></box></geometry>
     <material>
      <ambient>0.7 0.7 0.7 1</ambient>
      <diffuse>0.8 0.8 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- Outer wall — South (bottom) -->
  <model name="wall_south">
   <static>true</static>
   <pose>5 0 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>10 0.15 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>10 0.15 1.0</size></box></geometry>
     <material>
      <ambient>0.7 0.7 0.7 1</ambient>
      <diffuse>0.8 0.8 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- Outer wall — West (left) -->
  <model name="wall_west">
   <static>true</static>
   <pose>0 4 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>0.15 8 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>0.15 8 1.0</size></box></geometry>
     <material>
      <ambient>0.7 0.7 0.7 1</ambient>
      <diffuse>0.8 0.8 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- Outer wall — East (right) -->
  <model name="wall_east">
   <static>true</static>
   <pose>10 4 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>0.15 8 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>0.15 8 1.0</size></box></geometry>
     <material>
      <ambient>0.7 0.7 0.7 1</ambient>
      <diffuse>0.8 0.8 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- Interior wall — Vertical divider (creates hallway) -->
  <model name="wall_interior_v1">
   <static>true</static>
   <pose>3 3 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>0.15 4 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>0.15 4 1.0</size></box></geometry>
     <material>
      <ambient>0.6 0.6 0.7 1</ambient>
      <diffuse>0.7 0.7 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- Interior wall — Horizontal (Room1 top) -->
  <model name="wall_interior_h1">
   <static>true</static>
   <pose>3.5 6 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>3 0.15 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>3 0.15 1.0</size></box></geometry>
     <material>
      <ambient>0.6 0.6 0.7 1</ambient>
      <diffuse>0.7 0.7 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- Interior wall — Horizontal (Room3 divider) -->
  <model name="wall_interior_h2">
   <static>true</static>
   <pose>7 4 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>4 0.15 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>4 0.15 1.0</size></box></geometry>
     <material>
      <ambient>0.6 0.6 0.7 1</ambient>
      <diffuse>0.7 0.7 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

  <!-- Interior wall — Short vertical (between rooms) -->
  <model name="wall_interior_v2">
   <static>true</static>
   <pose>5 3 0.5 0 0 0</pose>
   <link name="link">
    <collision name="collision">
     <geometry><box><size>0.15 2 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
     <geometry><box><size>0.15 2 1.0</size></box></geometry>
     <material>
      <ambient>0.6 0.6 0.7 1</ambient>
      <diffuse>0.7 0.7 0.8 1</diffuse>
     </material>
    </visual>
   </link>
  </model>

 </world>
</sdf>
