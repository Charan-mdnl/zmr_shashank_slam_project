<?xml version="1.0" encoding="utf-8"?>
<!--
  ZMR Robot — SIMULATION URDF (v3 — TurtleBot3-proven pattern)
  ==============================================================
  Based on the proven TurtleBot3 Burger URDF structure that works
  reliably in Gazebo Classic.
  
  KEY FIXES from v2:
  1. base_footprint has ZERO inertia (pure virtual link, like TurtleBot3)
  2. Simplified to 3 links: base_link (chassis), 2 drive wheels, 1 caster ball
  3. Removed the cad_base_link intermediate frame (Gazebo merges fixed joints)
  4. All geometry centered at link origins (no offset origins)
  5. Caster is a single frictionless sphere (not swivel+wheel)
  
  Frame tree:
    base_footprint -> base_link -> lidar_link
                                -> left_wheel
                                -> right_wheel
                                -> caster_wheel (front)
                                -> caster_wheel_rear
-->
<robot name="zmr_robot">

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- BASE FOOTPRINT — virtual ground reference (NO mass) -->
 <!-- ═══════════════════════════════════════════════════ -->
 <link name="base_footprint"/>

 <joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0.0 0.0 0.033" rpy="0 0 0"/>
 </joint>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- BASE LINK — chassis (center between wheel axles)    -->
 <!-- Dimensions: 0.70 x 0.50 x 0.18m                    -->
 <!-- ═══════════════════════════════════════════════════ -->
 <link name="base_link">
  <visual>
   <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
   <geometry>
    <box size="0.70 0.50 0.18"/>
   </geometry>
   <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
   <geometry>
    <box size="0.70 0.50 0.18"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
   <mass value="10.0"/>
   <inertia ixx="0.2408" ixy="0.0" ixz="0.0"
            iyy="0.4358" iyz="0.0" izz="0.5817"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- LEFT WHEEL — cylinder, radius=0.08m, width=0.04m   -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="left_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <origin xyz="0.0 0.263 0.047" rpy="-1.5707963 0 0"/>
  <axis xyz="0 0 1"/>
 </joint>

 <link name="left_wheel">
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
   <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <mass value="1.0"/>
   <inertia ixx="0.00177" ixy="0.0" ixz="0.0"
            iyy="0.00177" iyz="0.0" izz="0.0032"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- RIGHT WHEEL — mirror of left                        -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="right_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <origin xyz="0.0 -0.263 0.047" rpy="-1.5707963 0 0"/>
  <axis xyz="0 0 1"/>
 </joint>

 <link name="right_wheel">
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
   <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <mass value="1.0"/>
   <inertia ixx="0.00177" ixy="0.0" ixz="0.0"
            iyy="0.00177" iyz="0.0" izz="0.0032"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- FRONT CASTER — frictionless sphere, radius=0.033m   -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="caster_front_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_front"/>
  <origin xyz="0.28 0.0 0.0" rpy="0 0 0"/>
 </joint>

 <link name="caster_front">
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
   <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <mass value="0.2"/>
   <inertia ixx="0.0000087" ixy="0.0" ixz="0.0"
            iyy="0.0000087" iyz="0.0" izz="0.0000087"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- REAR CASTER — frictionless sphere                   -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="caster_rear_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_rear"/>
  <origin xyz="-0.28 0.0 0.0" rpy="0 0 0"/>
 </joint>

 <link name="caster_rear">
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
   <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <mass value="0.2"/>
   <inertia ixx="0.0000087" ixy="0.0" ixz="0.0"
            iyy="0.0000087" iyz="0.0" izz="0.0000087"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- LIDAR — on top of chassis                           -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="lidar_joint" type="fixed">
  <parent link="base_link"/>
  <child link="lidar_link"/>
  <origin xyz="0.0 0.0 0.185" rpy="0 0 0"/>
 </joint>

 <link name="lidar_link">
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.04" length="0.04"/>
   </geometry>
   <material name="blue">
    <color rgba="0.0 0.2 0.8 1.0"/>
   </material>
  </visual>
  <inertial>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <mass value="0.2"/>
   <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
            iyy="0.0001" iyz="0.0" izz="0.0001"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- GAZEBO COLORS & FRICTION                            -->
 <!-- ═══════════════════════════════════════════════════ -->
 <gazebo reference="base_link">
  <material>Gazebo/DarkGrey</material>
 </gazebo>
 <gazebo reference="left_wheel">
  <material>Gazebo/FlatBlack</material>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
 </gazebo>
 <gazebo reference="right_wheel">
  <material>Gazebo/FlatBlack</material>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
 </gazebo>
 <gazebo reference="caster_front">
  <material>Gazebo/Grey</material>
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
 </gazebo>
 <gazebo reference="caster_rear">
  <material>Gazebo/Grey</material>
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
 </gazebo>
 <gazebo reference="lidar_link">
  <material>Gazebo/Blue</material>
 </gazebo>

  <!-- ═══════════════════════════════════════════════════ -->
 <!-- GAZEBO SIM (Harmonic / gz-sim 8) SYSTEM PLUGINS      -->
 <!--                                                      -->
 <!-- ROS 2 Jazzy ships Gazebo Sim, not Gazebo Classic, so  -->
 <!-- the libgazebo_ros_*.so plugins this file used before  -->
 <!-- do not exist and never loaded. These are the Gazebo   -->
 <!-- Sim equivalents; ROS topics come from ros_gz_bridge   -->
 <!-- (see launch/slam_sim.launch.py).                      -->
 <!-- ═══════════════════════════════════════════════════ -->

 <gazebo>
  <plugin filename="gz-sim-diff-drive-system"
          name="gz::sim::systems::DiffDrive">
   <left_joint>left_wheel_joint</left_joint>
   <right_joint>right_wheel_joint</right_joint>
   <wheel_separation>0.526</wheel_separation>
   <wheel_radius>0.080</wheel_radius>
   <max_linear_acceleration>0.6</max_linear_acceleration>
   <topic>cmd_vel</topic>
   <odom_topic>odom</odom_topic>
   <tf_topic>tf</tf_topic>
   <frame_id>odom</frame_id>
   <child_frame_id>base_footprint</child_frame_id>
   <odom_publish_frequency>30</odom_publish_frequency>
  </plugin>
 </gazebo>

 <gazebo>
  <plugin filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePublisher">
   <topic>joint_states</topic>
   <joint_name>left_wheel_joint</joint_name>
   <joint_name>right_wheel_joint</joint_name>
  </plugin>
 </gazebo>

 <!-- RPLidar A3M1. gz-sim uses gpu_lidar; the sensor is rendered by the
      gz-sim-sensors-system declared in the world file. -->
 <gazebo reference="lidar_link">
  <sensor name="rplidar" type="gpu_lidar">
   <pose>0 0 0 0 0 0</pose>
   <topic>scan</topic>
   <gz_frame_id>lidar_link</gz_frame_id>
   <update_rate>10</update_rate>
   <always_on>1</always_on>
   <visualize>false</visualize>
   <lidar>
    <scan>
     <horizontal>
      <samples>720</samples>
      <resolution>1</resolution>
      <min_angle>-3.14159</min_angle>
      <max_angle>3.14159</max_angle>
     </horizontal>
     <vertical>
      <samples>1</samples>
      <min_angle>0</min_angle>
      <max_angle>0</max_angle>
     </vertical>
    </scan>
    <range>
     <min>0.20</min>
     <max>25.0</max>
     <resolution>0.01</resolution>
    </range>
    <noise>
     <type>gaussian</type>
     <mean>0.0</mean>
     <stddev>0.01</stddev>
    </noise>
   </lidar>
  </sensor>
 </gazebo>

</robot>
