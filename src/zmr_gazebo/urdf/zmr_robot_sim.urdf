<!--
  ZMR Robot — SIMULATION URDF (v4 — 4-Caster Match)
  ==============================================================
  Matches the original CAD topology exactly (4 casters at corners, 
  drive wheels slightly offset in X), but uses primitive shapes 
  and the TurtleBot3 stable physics pattern so it works perfectly 
  in Gazebo without sinking or flipping.
-->
<robot name="zmr_robot">

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- BASE FOOTPRINT — virtual ground reference (NO mass) -->
 <!-- ═══════════════════════════════════════════════════ -->
 <link name="base_footprint"/>

 <joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0.0 0.0 0.033" rpy="0 0 0"/>
 </joint>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- BASE LINK — chassis                                 -->
 <!-- Matches original CAD size bounding box approx       -->
 <!-- ═══════════════════════════════════════════════════ -->
 <link name="base_link">
  <visual>
   <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
   <geometry>
    <box size="0.95 0.65 0.18"/>
   </geometry>
   <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
   <geometry>
    <box size="0.95 0.65 0.18"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
   <mass value="15.0"/>
   <inertia ixx="0.56" ixy="0.0" ixz="0.0"
            iyy="1.16" iyz="0.0" izz="1.65"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- LEFT WHEEL                                          -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="left_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <origin xyz="-0.035 0.263 0.047" rpy="-1.5707963 0 0"/>
  <axis xyz="0 0 1"/>
 </joint>

 <link name="left_wheel">
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
   <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <mass value="1.0"/>
   <inertia ixx="0.00177" ixy="0.0" ixz="0.0"
            iyy="0.00177" iyz="0.0" izz="0.0032"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- RIGHT WHEEL                                         -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="right_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <origin xyz="-0.035 -0.263 0.047" rpy="-1.5707963 0 0"/>
  <axis xyz="0 0 1"/>
 </joint>

 <link name="right_wheel">
  <visual>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
   <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
   </material>
  </visual>
  <collision>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <geometry>
    <cylinder radius="0.08" length="0.04"/>
   </geometry>
  </collision>
  <inertial>
   <origin xyz="0 0 0" rpy="0 0 0"/>
   <mass value="1.0"/>
   <inertia ixx="0.00177" ixy="0.0" ixz="0.0"
            iyy="0.00177" iyz="0.0" izz="0.0032"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- FRONT LEFT CASTER                                   -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="caster_fl_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_fl"/>
  <origin xyz="0.4575 0.2875 0.0" rpy="0 0 0"/>
 </joint>

 <link name="caster_fl">
  <visual>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
   <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  </visual>
  <collision>
   <geometry>
    <sphere radius="0.030"/>
   </geometry>
  </collision>
  <inertial>
   <mass value="0.2"/>
   <inertia ixx="0.000087" ixy="0.0" ixz="0.0" iyy="0.000087" iyz="0.0" izz="0.000087"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- FRONT RIGHT CASTER                                  -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="caster_fr_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_fr"/>
  <origin xyz="0.4575 -0.2875 0.0" rpy="0 0 0"/>
 </joint>

 <link name="caster_fr">
  <visual>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
   <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  </visual>
  <collision>
   <geometry>
    <sphere radius="0.030"/>
   </geometry>
  </collision>
  <inertial>
   <mass value="0.2"/>
   <inertia ixx="0.000087" ixy="0.0" ixz="0.0" iyy="0.000087" iyz="0.0" izz="0.000087"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- REAR LEFT CASTER                                    -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="caster_rl_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_rl"/>
  <origin xyz="-0.4575 0.2875 0.0" rpy="0 0 0"/>
 </joint>

 <link name="caster_rl">
  <visual>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
   <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  </visual>
  <collision>
   <geometry>
    <sphere radius="0.030"/>
   </geometry>
  </collision>
  <inertial>
   <mass value="0.2"/>
   <inertia ixx="0.000087" ixy="0.0" ixz="0.0" iyy="0.000087" iyz="0.0" izz="0.000087"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- REAR RIGHT CASTER                                   -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="caster_rr_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_rr"/>
  <origin xyz="-0.4575 -0.2875 0.0" rpy="0 0 0"/>
 </joint>

 <link name="caster_rr">
  <visual>
   <geometry>
    <sphere radius="0.033"/>
   </geometry>
   <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  </visual>
  <collision>
   <geometry>
    <sphere radius="0.030"/>
   </geometry>
  </collision>
  <inertial>
   <mass value="0.2"/>
   <inertia ixx="0.000087" ixy="0.0" ixz="0.0" iyy="0.000087" iyz="0.0" izz="0.000087"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- LIDAR                                               -->
 <!-- ═══════════════════════════════════════════════════ -->
 <joint name="lidar_joint" type="fixed">
  <parent link="base_link"/>
  <child link="lidar_link"/>
  <origin xyz="0.0 0.0 0.185" rpy="0 0 0"/>
 </joint>

 <link name="lidar_link">
  <visual>
   <geometry>
    <cylinder radius="0.04" length="0.04"/>
   </geometry>
   <material name="blue">
    <color rgba="0.0 0.2 0.8 1.0"/>
   </material>
  </visual>
  <inertial>
   <mass value="0.2"/>
   <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
  </inertial>
 </link>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- GAZEBO COLORS & FRICTION                            -->
 <!-- ═══════════════════════════════════════════════════ -->
 <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
 <gazebo reference="lidar_link"><material>Gazebo/Blue</material></gazebo>
 
 <gazebo reference="left_wheel">
  <material>Gazebo/FlatBlack</material>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
 </gazebo>
 <gazebo reference="right_wheel">
  <material>Gazebo/FlatBlack</material>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
 </gazebo>

 <!-- Casters must be frictionless! -->
 <gazebo reference="caster_fl">
  <material>Gazebo/Grey</material>
  <mu1>0.0</mu1><mu2>0.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
 </gazebo>
 <gazebo reference="caster_fr">
  <material>Gazebo/Grey</material>
  <mu1>0.0</mu1><mu2>0.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
 </gazebo>
 <gazebo reference="caster_rl">
  <material>Gazebo/Grey</material>
  <mu1>0.0</mu1><mu2>0.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
 </gazebo>
 <gazebo reference="caster_rr">
  <material>Gazebo/Grey</material>
  <mu1>0.0</mu1><mu2>0.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
 </gazebo>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- DIFFERENTIAL DRIVE PLUGIN                           -->
 <!-- ═══════════════════════════════════════════════════ -->
 <gazebo>
  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
   <left_joint>left_wheel_joint</left_joint>
   <right_joint>right_wheel_joint</right_joint>
   <wheel_separation>0.526</wheel_separation>
   <wheel_diameter>0.160</wheel_diameter>
   <max_wheel_torque>20.0</max_wheel_torque>
   <max_wheel_acceleration>1.0</max_wheel_acceleration>
   <command_topic>cmd_vel</command_topic>
   <odometry_topic>odom</odometry_topic>
   <odometry_frame>odom</odometry_frame>
   <robot_base_frame>base_footprint</robot_base_frame>
   <publish_odom>true</publish_odom>
   <publish_odom_tf>true</publish_odom_tf>
   <publish_wheel_tf>true</publish_wheel_tf>
   <update_rate>30.0</update_rate>
  </plugin>
 </gazebo>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- LIDAR SENSOR PLUGIN                                 -->
 <!-- ═══════════════════════════════════════════════════ -->
 <gazebo reference="lidar_link">
  <sensor type="ray" name="rplidar">
   <pose>0 0 0 0 0 0</pose>
   <visualize>true</visualize>
   <update_rate>10</update_rate>
   <ray>
    <scan>
     <horizontal>
      <samples>360</samples>
      <resolution>1</resolution>
      <min_angle>-3.14159</min_angle>
      <max_angle>3.14159</max_angle>
     </horizontal>
    </scan>
    <range>
     <min>0.15</min>
     <max>12.0</max>
     <resolution>0.01</resolution>
    </range>
    <noise>
     <type>gaussian</type>
     <mean>0.0</mean>
     <stddev>0.01</stddev>
    </noise>
   </ray>
   <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
    <ros>
     <remapping>~/out:=scan</remapping>
    </ros>
    <output_type>sensor_msgs/LaserScan</output_type>
    <frame_name>lidar_link</frame_name>
   </plugin>
  </sensor>
 </gazebo>

 <!-- ═══════════════════════════════════════════════════ -->
 <!-- JOINT STATE PUBLISHER PLUGIN                        -->
 <!-- ═══════════════════════════════════════════════════ -->
 <gazebo>
  <plugin name="joint_state_pub" filename="libgazebo_ros_joint_state_publisher.so">
   <ros>
    <remapping>~/out:=joint_states</remapping>
   </ros>
   <update_rate>30</update_rate>
   <joint_name>left_wheel_joint</joint_name>
   <joint_name>right_wheel_joint</joint_name>
  </plugin>
 </gazebo>

</robot>
