<?xml version="1.0"?>
<package format="3">
  <name>zmr_gazebo</name>
  <version>0.1.0</version>
  <description>ZMR Robot Gazebo simulation: world files, spawn launch, and SLAM pipeline</description>
  <maintainer email="charan@todo.todo">charan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Our robot description package (for the URDF) -->
  <exec_depend>zmr_description</exec_depend>

  <!-- Gazebo simulator and its ROS 2 bridge -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>

  <!-- For publishing the robot model to ROS from URDF -->
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- SLAM and navigation -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>

  <!-- Keyboard teleoperation (to drive the robot) -->
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
